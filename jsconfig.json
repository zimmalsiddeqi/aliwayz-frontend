{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*":           ["src/*"],
      "@features/*":   ["src/features/*"],
      "@router/*":     ["src/router/*"],
      "@shared/*":     ["src/*"],
      "@api/*":        ["src/api/*"],
      "@components/*": ["src/components/*"],
      "@hooks/*":      ["src/hooks/*"],
      "@lib/*":        ["src/lib/*"],
      "@store/*":      ["src/store/*"],
      "@styles/*":     ["src/styles/*"],
      "@utils/*":      ["src/utils/*"],
      "@types/*":      ["src/types/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}